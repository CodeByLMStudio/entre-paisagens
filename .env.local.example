# Variáveis de ambiente (exemplo). Copie para `.env.local` e ajuste.
# Nesta fase, a aplicação não exige segredos — a geocodificação reversa usa
# o Nominatim público. Endpoints externos podem ser configurados aqui no futuro.
NEXT_PUBLIC_NOMINATIM_URL=https://nominatim.openstreetmap.org/reverse

# Número de WhatsApp de destino do "Fale Conosco" (apenas dígitos, com DDI 55 + DDD).
NEXT_PUBLIC_WHATSAPP_NUMBER=5585987654321
